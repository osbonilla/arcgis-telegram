# Copia este archivo como .env y completa los valores

# --- Telegram (lo da @BotFather al crear el bot) ---
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- ArcGIS ---
ARCGIS_PORTAL=https://www.arcgis.com
ARCGIS_USERNAME=tu_usuario
ARCGIS_PASSWORD=tu_contraseña
# Alternativa al usuario/contraseña: API key con privilegio de edición sobre la capa
ARCGIS_API_KEY=

# La imprime crear_capa.py (termina en /FeatureServer/0)
ARCGIS_LAYER_URL=

# Opcional: link al Dashboard o mapa que el bot envía después de cada reporte
MAPA_URL=

# Opcional: id del grupo de Telegram de la clase (usa /chatid dentro del grupo para obtenerlo).
# El bot publica ahí cada reporte nuevo y cada reporte atendido. Ejemplo: -1001234567890
GRUPO_CHAT_ID=

# Cada cuántos segundos el bot revisa si un técnico cambió el estado
INTERVALO_REVISION_SEG=15
